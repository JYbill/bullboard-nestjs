+
+it('refreshes the selected page and status with polling off, even on an empty read-only queue', async () => {
+  const queues = [
+    makeQueue('reports', {
+      readOnlyMode: true,
+      pagination: { pageCount: 2, range: { start: 10, end: 19 } },
+    }),
+  ];
+  const response = deferred<GetQueuesResponse>();
+  const getQueues = jest
+    .fn(() => Promise.resolve<GetQueuesResponse>({ queues }))
+    .mockImplementationOnce(() => Promise.resolve({ queues }))
+    .mockImplementationOnce(() => response.promise);
+  const history = createMemoryHistory({ initialEntries: ['/queue/reports?page=2&status=waiting'] });
+  const { Wrapper } = createWrapper({ api: { getQueues }, history });
+  render(<QueuePage />, { wrapper: Wrapper });
+
+  const refresh = await screen.findByRole('button', { name: 'QUEUE.REFRESH' });
+  expect(refresh.textContent).toBe('');
+  fireEvent.click(refresh);
+
+  await waitFor(() => expect(refresh).toHaveProperty('disabled', true));
+  fireEvent.click(refresh);
+  expect(getQueues).toHaveBeenCalledTimes(2);
+  expect(getQueues).toHaveBeenLastCalledWith({
+    activeQueue: 'reports',
+    status: 'waiting',
+    page: '2',
+    jobsPerPage: 10,
+  });
+  expect(history.location.search).toBe('?page=2&status=waiting');
+
+  await act(async () => response.resolve({ queues }));
+  await waitFor(() => expect(refresh).toHaveProperty('disabled', false));
+});
