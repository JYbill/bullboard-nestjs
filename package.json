{
  "name": "rag-server",
  "version": "1.0.3",
  "private": true,
  "description": "bull board 管理面板",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "skills:update": "skills add https://github.com/JYbill/xqv-skills --copy -a universal claude-code -y -s ddt -s notes -s summary -s upgrade-project -s test-optimize",
    "prepare": "husky",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint --config oxlint.config.ts src test --fix",
    "test": "vitest run --project test --passWithNoTests",
    "test:watch": "vitest --project test",
    "test:cov": "vitest run --coverage --project test --passWithNoTests",
    "test:debug": "vitest --inspectBrk --project test --testTimeout 0 --hookTimeout 0",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "deploy:docker": "bash ./docker-build.sh -p x86-debian",
    "deploy:docker:local": "bash ./docker-build.sh -p x86-debian -s"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@swc/helpers": "^0.5.23",
    "bull": "^4.16.5",
    "bullmq": "^6.3.17",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "skills": "^1.7.2",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
